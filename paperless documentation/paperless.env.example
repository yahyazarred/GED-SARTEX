# Copier ce fichier vers paperless.env avant le premier démarrage.

# OBLIGATOIRE : générer une valeur avec la commande indiquée dans le guide.
PAPERLESS_SECRET_KEY=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_OCTETS

PAPERLESS_TIME_ZONE=Europe/Paris
PAPERLESS_OCR_LANGUAGE=fra
PAPERLESS_OCR_LANGUAGES=fra eng
PAPERLESS_FILENAME_FORMAT={created_year}/{correspondent}/{title}

# Décommenter si l'application est publiée derrière un domaine HTTPS.
# PAPERLESS_URL=https://ged.example.com
# PAPERLESS_CSRF_TRUSTED_ORIGINS=https://ged.example.com
# PAPERLESS_ALLOWED_HOSTS=ged.example.com

# Adapter à l'utilisateur du serveur Linux pour les dossiers consume/export.
# USERMAP_UID=1000
# USERMAP_GID=1000
